<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BuildMaterialsSource Condition="'$(BuildMaterialsSource)' == ''">$(MSBuildThisFileDirectory)../../mods/OniMcp/Tools/Impl/Build/BuildPlanningMaterials.cs</BuildMaterialsSource>
    <MaterialQuantitySource>$(MSBuildThisFileDirectory)../../mods/OniMcp/Tools/Impl/Build/MaterialQuantityDiagnostics.cs</MaterialQuantitySource>
    <McpJsonSource>$(MSBuildThisFileDirectory)../../mods/OniMcp/Support/McpJsonUtil.cs</McpJsonSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BuildMaterialsSource)" Link="Source/BuildPlanningMaterials.cs" />
    <Compile Include="$(MaterialQuantitySource)" Link="Source/MaterialQuantityDiagnostics.cs" />
    <Compile Include="$(McpJsonSource)" Link="Source/McpJsonUtil.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <AssemblyMetadata Include="BuildMaterialsSource" Value="$(BuildMaterialsSource)" />
    <AssemblyMetadata Include="MaterialQuantitySource" Value="$(MaterialQuantitySource)" />
    <AssemblyMetadata Include="McpJsonSource" Value="$(McpJsonSource)" />
  </ItemGroup>
</Project>
