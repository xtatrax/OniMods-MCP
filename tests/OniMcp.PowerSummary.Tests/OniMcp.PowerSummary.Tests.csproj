<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PowerSummarySource Condition="'$(PowerSummarySource)' == ''">$(MSBuildProjectDirectory)/../../mods/OniMcp/Tools/Impl/Build/PowerSummaryTools.cs</PowerSummarySource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../mods/OniMcp/Core/McpTypes.cs" Link="Source/McpTypes.cs" />
    <Compile Include="../../mods/OniMcp/Core/McpContentTypes.cs" Link="Source/McpContentTypes.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
  </ItemGroup>
  <Target Name="ExtractPowerSummaryProductionSource" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract_sources.py&quot; --repo &quot;$(MSBuildProjectDirectory)/../..&quot; --source &quot;$(PowerSummarySource)&quot; --output &quot;$(IntermediateOutputPath)PowerSummaryExtracted.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)PowerSummaryExtracted.cs" /></ItemGroup>
  </Target>
</Project>
