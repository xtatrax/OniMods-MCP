<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PreviewMaterialSource Condition="'$(PreviewMaterialSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningMaterials.cs</PreviewMaterialSource>
    <PlacementModelsSource Condition="'$(PlacementModelsSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningTools.cs</PlacementModelsSource>
    <ToiletReaderSource Condition="'$(ToiletReaderSource)' == ''">../../mods/OniMcp/Tools/Impl/Orders/MaintenanceToiletInfo.cs</ToiletReaderSource>
    <DefineConstants Condition="'$(ToiletLegacyComparison)' == 'true'">$(DefineConstants);TOILET_LEGACY_COMPARISON</DefineConstants>
    <NativeBlueprintSource Condition="'$(NativeBlueprintSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/NativeBlueprintInstantCompletion.cs</NativeBlueprintSource>
    <ExistingBlueprintSource Condition="'$(ExistingBlueprintSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningExistingBlueprintCompletion.cs</ExistingBlueprintSource>
    <BlueprintObstructionsSource Condition="'$(BlueprintObstructionsSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningObstructions.cs</BlueprintObstructionsSource>
    <BlueprintSafetySource Condition="'$(BlueprintSafetySource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningPlacementSafety.cs</BlueprintSafetySource>
    <BlueprintGeometrySource Condition="'$(BlueprintGeometrySource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningPlacementGeometry.cs</BlueprintGeometrySource>
    <BlueprintRuntimeSource Condition="'$(BlueprintRuntimeSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningRuntimePlacement.cs</BlueprintRuntimeSource>
    <BlueprintInstantSource Condition="'$(BlueprintInstantSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningInstantCompletion.cs</BlueprintInstantSource>
    <PlanOneSource Condition="'$(PlanOneSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningPlanOne.cs</PlanOneSource>
    <PreviewAnchorsSource Condition="'$(PreviewAnchorsSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningAnchors.cs</PreviewAnchorsSource>
    <PreviewPlacementSource Condition="'$(PreviewPlacementSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningActionPlacement.cs</PreviewPlacementSource>
    <TileReplacementSource Condition="'$(TileReplacementSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningTileReplacement.cs</TileReplacementSource>
    <TileReplacementStateSource Condition="'$(TileReplacementStateSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/BuildPlanningTileReplacementState.cs</TileReplacementStateSource>
    <NativeTileReplacementSource Condition="'$(NativeTileReplacementSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/NativeTileReplacement.cs</NativeTileReplacementSource>
    <NativeTileReplacementStateSource Condition="'$(NativeTileReplacementStateSource)' == ''">../../mods/OniMcp/Tools/Impl/Build/NativeTileReplacementState.cs</NativeTileReplacementStateSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../mods/OniMcp/Tools/Shared/ConstructionModeObservation.cs" Link="Source/ConstructionModeObservation.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Shared/PreviewValidationObservation.cs" Link="Source/PreviewValidationObservation.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildPlanningObservationScopes.cs" Link="Source/BuildPlanningObservationScopes.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildPlanningUnknownReadObservations.cs" Link="Source/BuildPlanningUnknownReadObservations.cs" />

    <Compile Include="../../mods/OniMcp/Core/McpContentTypes.cs" Link="Source/McpContentTypes.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildPlanningPreviewReadContext.cs" Link="Source/BuildPlanningPreviewReadContext.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/MaterialQuantityDiagnostics.cs" Link="Source/MaterialQuantityDiagnostics.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildingOperationGuidance.cs" Link="Source/BuildingOperationGuidance.cs" />
    <Compile Include="$(ToiletReaderSource)" Link="Source/MaintenanceToiletInfo.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Orders/NativeBuildingToggle.cs" Link="Source/NativeBuildingToggle.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Orders/NativePlayerToggleUi.cs" Link="Source/NativePlayerToggleUi.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildPlanningExistingMaterialReader.cs" Link="Source/BuildPlanningExistingMaterialReader.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildingAvailabilityReader.cs" Link="Source/BuildingAvailabilityReader.cs" />
    <Compile Include="$(NativeBlueprintSource)" Link="Source/NativeBlueprintInstantCompletion.cs" />
    <Compile Include="$(ExistingBlueprintSource)" Link="Source/BuildPlanningExistingBlueprintCompletion.cs" />
    <Compile Include="$(PlanOneSource)" Link="Source/BuildPlanningPlanOne.cs" />
    <Compile Include="$(TileReplacementSource)" Link="Source/BuildPlanningTileReplacement.cs" />
    <Compile Include="$(TileReplacementStateSource)" Link="Source/BuildPlanningTileReplacementState.cs" />
    <Compile Include="$(NativeTileReplacementSource)" Link="Source/NativeTileReplacement.cs" />
    <Compile Include="$(NativeTileReplacementStateSource)" Link="Source/NativeTileReplacementState.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildPlanningExistingMaterialValidation.cs" Link="Source/BuildPlanningExistingMaterialValidation.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildPlanningExistingMaterialPolicy.cs" Link="Source/BuildPlanningExistingMaterialPolicy.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <Compile Include="../../mods/OniMcp/Localization/McpLocalization.cs" Link="Source/McpLocalization.cs" />
    <EmbeddedResource Include="../../mods/OniMcp/Localization/Catalogs/*.json" LogicalName="OniMcp.Localization.Catalogs.%(Filename)%(Extension)" WithCulture="false" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="GenerateBlueprintSafetySource" BeforeTargets="BeforeCompile">
    <PropertyGroup><BlueprintGeneratedSource>$(IntermediateOutputPath)BlueprintSafety.g.cs</BlueprintGeneratedSource></PropertyGroup>
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)extract_blueprint_safety.py&quot; --repo-root &quot;$(MSBuildThisFileDirectory)../../&quot; --output &quot;$(BlueprintGeneratedSource)&quot; --materials &quot;$(PreviewMaterialSource)&quot; --candidate-models &quot;$(MSBuildThisFileDirectory)../../mods/OniMcp/Tools/Impl/Build/BuildPlanningModels.cs&quot; --candidate-results &quot;$(MSBuildThisFileDirectory)../../mods/OniMcp/Tools/Impl/Build/BuildPlanningPlanResults.cs&quot; --obstructions &quot;$(BlueprintObstructionsSource)&quot; --safety &quot;$(BlueprintSafetySource)&quot; --geometry &quot;$(BlueprintGeometrySource)&quot; --runtime &quot;$(BlueprintRuntimeSource)&quot; --instant &quot;$(BlueprintInstantSource)&quot; --anchors &quot;$(PreviewAnchorsSource)&quot; --placement &quot;$(PreviewPlacementSource)&quot; --models &quot;$(PlacementModelsSource)&quot;" />
    <ItemGroup><Compile Include="$(BlueprintGeneratedSource)" /></ItemGroup>
  </Target>
<ItemGroup><Compile Include="../../mods/OniMcp/Tools/Impl/Build/MaterialInventoryObservation.cs" Link="Source/MaterialInventoryObservation.cs" /></ItemGroup>
</Project>
