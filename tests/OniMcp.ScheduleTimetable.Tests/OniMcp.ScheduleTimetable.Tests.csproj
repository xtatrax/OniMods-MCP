<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>true</NuGetAudit>
    <ProductRoot Condition="'$(ProductRoot)' == ''">../../mods/OniMcp</ProductRoot>
    <ScheduleSource Condition="'$(ScheduleSource)' == ''">$(ProductRoot)/Tools/Impl/Management/ScheduleTools.cs</ScheduleSource>
    <TimetableSource Condition="'$(TimetableSource)' == ''">$(ProductRoot)/Tools/Impl/Management/ScheduleTimetableTools.cs</TimetableSource>
    <ManagementSource Condition="'$(ManagementSource)' == ''">$(ProductRoot)/Tools/Impl/Management/ManagementTools.cs</ManagementSource>
    <ColonySource Condition="'$(ColonySource)' == ''">$(ProductRoot)/Tools/Impl/Colony/ColonyTools.cs</ColonySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ScheduleSource)" Link="Source/ScheduleTools.cs" />
    <Compile Include="$(TimetableSource)" Link="Source/ScheduleTimetableTools.cs" />
    <Compile Include="$(ProductRoot)/Tools/Impl/Management/ScheduleOptimizationTools.cs" Link="Source/ScheduleOptimizationTools.cs" />
    <Compile Include="$(ManagementSource)" Link="Source/ManagementTools.cs" />
    <Compile Include="$(ColonySource)" Link="Source/ColonyTools.cs" />
    <Compile Include="$(ProductRoot)/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <Compile Include="$(ProductRoot)/Core/McpTypes.cs" Link="Source/McpTypes.cs" />
    <Compile Include="$(ProductRoot)/Core/McpContentTypes.cs" Link="Source/McpContentTypes.cs" />
    <Compile Include="$(ProductRoot)/Tools/WorldEditor/WorldEditorResultEvidence.cs" Link="Source/WorldEditorResultEvidence.cs" />
    <Compile Include="$(ProductRoot)/Tools/WorldEditor/WorldEditorExecutionPolicy.cs" Link="Source/WorldEditorExecutionPolicy.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
