<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BuildSourceRoot Condition="'$(BuildSourceRoot)' == ''">../../mods/OniMcp/Tools/Impl/Build</BuildSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BuildSourceRoot)/BuildingAvailabilityReader.cs" Link="Source/BuildingAvailabilityReader.cs" />
    <Compile Include="$(BuildSourceRoot)/BuildPlanTextModels.cs" Link="Source/BuildPlanTextModels.cs" />
    <Compile Include="$(BuildSourceRoot)/BuildPlanTextParser.cs" Link="Source/BuildPlanTextParser.cs" />
    <Compile Include="$(BuildSourceRoot)/BuildPlanTextSequenceParser.cs" Link="Source/BuildPlanTextSequenceParser.cs" />
    <Compile Include="$(BuildSourceRoot)/BuildPlanningCatalog.cs" Link="Source/BuildPlanningCatalog.cs" />
    <Compile Include="$(BuildSourceRoot)/BuildPlanTextAliases.cs" Link="Source/BuildPlanTextAliases.cs" />
    <Compile Include="$(BuildSourceRoot)/BuildPlanExecutionPlanner.cs" Link="Source/BuildPlanExecutionPlanner.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Impl/Build/BuildingOperationGuidance.cs" Link="Source/BuildingOperationGuidance.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <Compile Include="../../mods/OniMcp/Localization/McpLocalization.cs" Link="Source/McpLocalization.cs" />
    <EmbeddedResource Include="../../mods/OniMcp/Localization/Catalogs/*.json" LogicalName="OniMcp.Localization.Catalogs.%(Filename)%(Extension)" WithCulture="false" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
