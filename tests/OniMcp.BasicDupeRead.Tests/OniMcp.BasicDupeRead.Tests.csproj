<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BasicDupeSourceRoot Condition="'$(BasicDupeSourceRoot)' == ''">../../mods/OniMcp/Tools/Impl/Colony</BasicDupeSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BasicDupeSourceRoot)/BasicDuplicantVitals.cs" Link="Source/BasicDuplicantVitals.cs" />
    <Compile Include="$(BasicDupeSourceRoot)/ColonyDuplicantReadTools.cs" Link="Source/ColonyDuplicantReadTools.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <Compile Include="../../mods/OniMcp/Localization/McpLocalization.cs" Link="Source/McpLocalization.cs" />
    <EmbeddedResource Include="../../mods/OniMcp/Localization/Catalogs/common.*.json" LogicalName="OniMcp.Localization.Catalogs.%(Filename)%(Extension)" WithCulture="false" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
