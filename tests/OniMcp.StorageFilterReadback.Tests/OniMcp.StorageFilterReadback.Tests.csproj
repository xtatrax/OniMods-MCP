<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StorageSourceRoot Condition="'$(StorageSourceRoot)' == ''">../../mods/OniMcp/Tools/Impl/Build</StorageSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(StorageSourceRoot)/StorageTools.cs" Link="Source/StorageTools.cs" />
    <Compile Include="$(StorageSourceRoot)/StorageTargetResolver.cs" Link="Source/StorageTargetResolver.cs" />
    <Compile Include="$(StorageSourceRoot)/StorageItemDetails.cs" Link="Source/StorageItemDetails.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
