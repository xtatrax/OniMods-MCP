<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MapHtmlSource Condition="'$(MapHtmlSource)' == ''">../../mods/OniMcp/Tools/WorldEditor/WorldEditorMapHtml.cs</MapHtmlSource>
    <McpLocalizationSource Condition="'$(McpLocalizationSource)' == ''">../../mods/OniMcp/Localization/McpLocalization.cs</McpLocalizationSource>
    <MapHtmlCatalogDirectory Condition="'$(MapHtmlCatalogDirectory)' == ''">../../mods/OniMcp/Localization/Catalogs</MapHtmlCatalogDirectory>
    <MapHtmlEnCatalogSource Condition="'$(MapHtmlEnCatalogSource)' == ''">$(MapHtmlCatalogDirectory)/map_html.en.json</MapHtmlEnCatalogSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MapHtmlSource)" Link="Source/WorldEditorMapHtml.cs" />
    <Compile Include="$(McpLocalizationSource)" Link="Source/McpLocalization.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <EmbeddedResource Include="$(MapHtmlEnCatalogSource)" LogicalName="OniMcp.Localization.Catalogs.map_html.en.json" WithCulture="false" />
    <EmbeddedResource Include="$(MapHtmlCatalogDirectory)/map_html.ja.json" LogicalName="OniMcp.Localization.Catalogs.map_html.ja.json" WithCulture="false" />
    <EmbeddedResource Include="$(MapHtmlCatalogDirectory)/map_html.zh-Hans.json" LogicalName="OniMcp.Localization.Catalogs.map_html.zh-Hans.json" WithCulture="false" />
  </ItemGroup>
</Project>
