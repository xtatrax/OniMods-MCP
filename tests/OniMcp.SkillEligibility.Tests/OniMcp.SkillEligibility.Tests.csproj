<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SkillToolsSource Condition="'$(SkillToolsSource)' == ''">../../mods/OniMcp/Tools/Impl/Dupes/DuplicantSkillHatTools.cs</SkillToolsSource>
    <SkillObservationSource Condition="'$(SkillObservationSource)' == ''">../../mods/OniMcp/Tools/Impl/Dupes/DuplicantSkillObservation.cs</SkillObservationSource>
    <NativeSkillUiSource Condition="'$(NativeSkillUiSource)' == ''">../../mods/OniMcp/Tools/Impl/Dupes/NativeSkillUi.cs</NativeSkillUiSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SkillToolsSource)" Link="Source/DuplicantSkillHatTools.cs" />
    <Compile Include="$(SkillObservationSource)" Link="Source/DuplicantSkillObservation.cs" />
    <Compile Include="$(NativeSkillUiSource)" Link="Source/NativeSkillUi.cs" />
    <Compile Include="../../mods/OniMcp/Core/McpContentTypes.cs" Link="Source/McpContentTypes.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <Compile Include="../../mods/OniMcp/Localization/McpLocalization.cs" Link="Source/McpLocalization.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <EmbeddedResource Include="../../mods/OniMcp/Localization/Catalogs/skill_model.*.json" LogicalName="OniMcp.Localization.Catalogs.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
