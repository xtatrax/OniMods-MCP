<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>CS0649</NoWarn>
    <BuildRoot>../../mods/OniMcp/Tools/Impl/Build</BuildRoot>
    <CandidateLayout>inline</CandidateLayout>
    <CandidateSource Condition="'$(CandidateSource)' == ''">$(BuildRoot)/BuildPlanningActionPlacement.cs</CandidateSource>
    <BuildingEntrySource Condition="'$(BuildingEntrySource)' == ''">../../mods/OniMcp/Tools/Entry/BuildingControlTools.cs</BuildingEntrySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BuildRoot)/BuildPlanningObservationScopes.cs" Link="Source/BuildPlanningObservationScopes.cs" Condition="Exists('$(BuildRoot)/BuildPlanningObservationScopes.cs')" />
    <Compile Include="../../mods/OniMcp/Tools/Shared/PreviewValidationObservation.cs" Link="Source/PreviewValidationObservation.cs" Condition="Exists('../../mods/OniMcp/Tools/Shared/PreviewValidationObservation.cs')" />
    <Compile Include="$(BuildingEntrySource)" Link="Source/BuildingControlTools.cs" />
    <Compile Include="$(CandidateSource)" Link="Source/CandidateLeaf.cs" Condition="'$(CandidateLayout)' == 'split'" />
    <Compile Include="$(BuildRoot)/BuildPlanningTools.cs" Link="Source/BuildPlanningTools.cs" />
    <Compile Include="$(BuildRoot)/BuildPlanningModels.cs" Link="Source/BuildPlanningModels.cs" />
    <Compile Include="$(BuildRoot)/BuildPlanningPlanResults.cs" Link="Source/BuildPlanningPlanResults.cs" />
    <Compile Include="$(BuildRoot)/BuildPlanningErrors.cs" Link="Source/BuildPlanningErrors.cs" />
    <Compile Include="../../mods/OniMcp/Core/McpTypes.cs" Link="Source/McpTypes.cs" />
    <Compile Include="../../mods/OniMcp/Core/McpContentTypes.cs" Link="Source/McpContentTypes.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <Compile Include="../../mods/OniMcp/Localization/McpLocalization.cs" Link="Source/McpLocalization.cs" />
    <EmbeddedResource Include="../../mods/OniMcp/Localization/Catalogs/*.json" LogicalName="OniMcp.Localization.Catalogs.%(Filename)%(Extension)" WithCulture="false" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <Target Name="GenerateExactGatewayRanges" BeforeTargets="BeforeCompile">
    <PropertyGroup><GatewayGenerated>$(IntermediateOutputPath)CandidateGateway.g.cs</GatewayGenerated></PropertyGroup>
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)extract_candidate_gateway.py&quot; --repo-root &quot;$(MSBuildThisFileDirectory)../../&quot; --registry &quot;$(MSBuildThisFileDirectory)../../mods/OniMcp/Tools/Core/OniToolRegistry.cs&quot; --candidate &quot;$(CandidateSource)&quot; --anchors &quot;$(BuildRoot)/BuildPlanningAnchors.cs&quot; --layout $(CandidateLayout) --output &quot;$(GatewayGenerated)&quot;" />
    <ItemGroup><Compile Include="$(GatewayGenerated)" /></ItemGroup>
  </Target>
</Project>
