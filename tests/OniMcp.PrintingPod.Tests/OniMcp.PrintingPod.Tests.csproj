<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OniMcpSourceRoot Condition="'$(OniMcpSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../mods/OniMcp</OniMcpSourceRoot>
    <FacilityLoreTelepadSource Condition="'$(FacilityLoreTelepadSource)' == ''">$(OniMcpSourceRoot)/Tools/Impl/Facility/FacilityLoreTelepadTools.cs</FacilityLoreTelepadSource>
    <ColonyAchievementSource Condition="'$(ColonyAchievementSource)' == ''">$(OniMcpSourceRoot)/Tools/Impl/Colony/ColonyAchievementTools.cs</ColonyAchievementSource>
    <NativeAchievementUiSource Condition="'$(NativeAchievementUiSource)' == ''">$(OniMcpSourceRoot)/Tools/Impl/Colony/NativeAchievementUi.cs</NativeAchievementUiSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="$(OniMcpSourceRoot)/Tools/Impl/Facility/FacilityPrintingPodRewardTools.cs" Link="FacilityPrintingPodRewardTools.cs" />
    <Compile Include="$(OniMcpSourceRoot)/Tools/Impl/Facility/PrintingPodCandidateObserver.cs" Link="PrintingPodCandidateObserver.cs" />
    <Compile Include="$(OniMcpSourceRoot)/Core/McpContentTypes.cs" Link="McpContentTypes.cs" />
    <Compile Include="$(OniMcpSourceRoot)/Config/PrintingPodSelectionPolicy.cs" Link="PrintingPodSelectionPolicy.cs" />
    <Compile Include="$(OniMcpSourceRoot)/Support/McpJsonUtil.cs" Link="McpJsonUtil.cs" />
    <Compile Include="$(OniMcpSourceRoot)/Tools/Impl/Colony/EntitySectionText.cs" Link="EntitySectionText.cs" />
    <Compile Include="$(FacilityLoreTelepadSource)" Link="FacilityLoreTelepadTools.cs" />
    <Compile Include="$(ColonyAchievementSource)" Link="ColonyAchievementTools.cs" />
    <Compile Include="$(NativeAchievementUiSource)" Link="NativeAchievementUi.cs" />
  </ItemGroup>
</Project>
