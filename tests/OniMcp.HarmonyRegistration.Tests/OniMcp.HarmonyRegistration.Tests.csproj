<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ModInfoSource Condition="'$(ModInfoSource)' == ''">../../mods/OniMcp/ModInfo.cs</ModInfoSource>
    <PatchAuditSource Condition="'$(PatchAuditSource)' == ''">../../mods/OniMcp/Support/OwnedHarmonyPatchAudit.cs</PatchAuditSource>
    <ServerSourceRoot Condition="'$(ServerSourceRoot)' == ''">../../mods/OniMcp/Tools/Impl/Server</ServerSourceRoot>
    <PatchSourceRoot Condition="'$(PatchSourceRoot)' == ''">../../mods/OniMcp/Patches</PatchSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ModInfoSource)" Link="Source/ModInfo.cs" />
    <Compile Include="$(PatchAuditSource)" Link="Source/OwnedHarmonyPatchAudit.cs" />
    <Compile Include="$(ServerSourceRoot)/ServerStatusTools.cs" Link="Source/ServerStatusTools.cs" />
    <Compile Include="$(ServerSourceRoot)/ServerTools.cs" Link="Source/ServerTools.cs" />
    <Compile Include="$(PatchSourceRoot)/SpeedTransitionTracePatch.cs" Link="Source/SpeedTransitionTracePatch.cs" />
    <Compile Include="$(PatchSourceRoot)/InputSafetyPatchVerifier.cs" Link="Source/InputSafetyPatchVerifier.cs" />
    <Compile Include="$(PatchSourceRoot)/AutoDisinfectPolicy.cs" Link="Source/AutoDisinfectPolicy.cs" />
    <Compile Include="../../mods/OniMcp/Core/McpTypes.cs" Link="Source/McpTypes.cs" />
    <Compile Include="../../mods/OniMcp/Core/McpContentTypes.cs" Link="Source/McpContentTypes.cs" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Source/McpJsonUtil.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
