<Project>
  <PropertyGroup>
    <!-- The repository's optional Directory.Build.props validates a game install. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NavigationControlSource Condition="'$(NavigationControlSource)' == ''">../../mods/OniMcp/Tools/Entry/NavigationControlTools.cs</NavigationControlSource>
    <CoreEnglishDescriptionsSource Condition="'$(CoreEnglishDescriptionsSource)' == ''">../../mods/OniMcp/Tools/Entry/CoreToolEnglishDescriptions.cs</CoreEnglishDescriptionsSource>
    <ColonyReportSource Condition="'$(ColonyReportSource)' == ''">../../mods/OniMcp/Tools/Impl/Colony/ColonyReportTools.cs</ColonyReportSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj/**/*.cs;bin/**/*.cs" />
    <Compile Include="../../mods/OniMcp/Localization/McpLocalization.cs" Link="Source/McpLocalization.cs" />
    <Compile Include="../../mods/OniMcp/Config/PrintingPodSelectionPolicy.cs" Link="Source/PrintingPodSelectionPolicy.cs" />
    <EmbeddedResource Include="../../mods/OniMcp/Localization/Catalogs/*.json" LogicalName="OniMcp.Localization.Catalogs.%(Filename)%(Extension)" WithCulture="false" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../mods/OniMcp/Core/*.cs" Link="Production/Core/%(Filename)%(Extension)" />
    <Compile Include="../../mods/OniMcp/Support/McpJsonUtil.cs" Link="Production/McpJsonUtil.cs" />
    <Compile Include="../../mods/OniMcp/Tools/Core/*.cs" Link="Production/Tools/%(Filename)%(Extension)" />
    <Compile Include="$(NavigationControlSource)" Link="Production/NavigationControlTools.cs" />
    <Compile Include="$(CoreEnglishDescriptionsSource)" Link="Production/CoreToolEnglishDescriptions.cs" />
    <Compile Include="$(ColonyReportSource)" Link="Production/ColonyReportTools.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
