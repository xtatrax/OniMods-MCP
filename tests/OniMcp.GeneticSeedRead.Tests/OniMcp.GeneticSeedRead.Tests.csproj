<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GeneticSeedOptionsSource Condition="'$(GeneticSeedOptionsSource)' == ''">../../mods/OniMcp/Tools/Impl/Facility/StoryFacilityGeneticSeedOptions.cs</GeneticSeedOptionsSource>
    <McpJsonSource Condition="'$(McpJsonSource)' == ''">../../mods/OniMcp/Support/McpJsonUtil.cs</McpJsonSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="$(GeneticSeedOptionsSource)" Link="StoryFacilityGeneticSeedOptions.cs" />
    <Compile Include="$(McpJsonSource)" Link="McpJsonUtil.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="BoundaryStubs.cs" />
  </ItemGroup>
</Project>
