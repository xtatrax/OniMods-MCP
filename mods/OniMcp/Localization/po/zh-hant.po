msgstr "UI子系統：action、feedback或dialog。"

#. Runtime JSON key: tools.game_control.parameters.dryRun
#. Runtime zh-Hans msgstr: "对于支持的操作，预览而不应用更改。uiDomain=dialog action=acknowledge 为 true 时验证当前目标而不调用按钮。其他操作仍遵守各自的预览约定。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.DRYRUN"
msgid "For supported actions, preview without applying changes. uiDomain=dialog action=acknowledge validates the current target without invoking its button when true. Other actions retain their own preview contract."
msgstr "對於支援的操作，預覽而不套用變更。uiDomain=dialog action=acknowledge 為 true 時驗證目前目標而不呼叫按鈕。其他操作仍遵守各自的預覽約定。"

#. Runtime JSON key: tools.game_control.parameters.dialog
#. Runtime zh-Hans msgstr: "uiDomain=dialog 的对话框种类。仅支持 mod_mismatch；不能确认其他对话框。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.DIALOG"
msgid "Dialog kind for uiDomain=dialog. Only mod_mismatch is supported; unrelated dialogs cannot be acknowledged."
msgstr "uiDomain=dialog 的對話框種類。僅支援 mod_mismatch；不能確認其他對話框。"

#. Runtime JSON key: tools.game_control.parameters.dialogToken
#. Runtime zh-Hans msgstr: "status 返回的当前MOD不匹配对话框的不透明令牌。acknowledge 必填，并在原生调用前重新核对。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.DIALOGTOKEN"
msgid "Opaque token returned by status for the current MOD mismatch dialog. Required for acknowledge and checked again before native invocation."
msgstr "status 傳回的目前MOD不匹配對話框的不透明權杖。acknowledge 必填，並在原生呼叫前重新核對。"

#. Runtime JSON key: ui_dialog.ui_control_description
#. Runtime zh-Hans msgstr: "UI统一入口：domain=action/feedback/dialog。支持允许的UI Action、玩家反馈，以及当前MOD不匹配对话框的显式读取与确认。"
msgctxt "OniMcp.MCP.UI_DIALOG.UI_CONTROL_DESCRIPTION"
msgid "Unified UI entrypoint: domain=action/feedback/dialog. Supports allowed UI actions, player feedback, and explicit status/acknowledge of the current MOD mismatch dialog."
msgstr "UI統一入口：domain=action/feedback/dialog。支援允許的UI Action、玩家回饋，以及目前MOD不匹配對話框的明確讀取與確認。"

#. Runtime JSON key: ui_dialog.ui_domain_description
#. Runtime zh-Hans msgstr: "UI子系统：action、feedback或dialog。"
msgctxt "OniMcp.MCP.UI_DIALOG.UI_DOMAIN_DESCRIPTION"
msgid "UI subsystem: action, feedback or dialog."
msgstr "UI子系統：action、feedback或dialog。"

#. Runtime JSON key: ui_dialog.ui_action_description
#. Runtime zh-Hans msgstr: "domain=action：list/trigger/open_management；domain=feedback：notification/popup/speech_bubble/marker；domain=dialog：status/acknowledge。"
msgctxt "OniMcp.MCP.UI_DIALOG.UI_ACTION_DESCRIPTION"
msgid "domain=action: list/trigger/open_management; domain=feedback: notification/popup/speech_bubble/marker; domain=dialog: status/acknowledge."
msgstr "domain=action：list/trigger/open_management；domain=feedback：notification/popup/speech_bubble/marker；domain=dialog：status/acknowledge。"

#. Runtime JSON key: ui_dialog.invalid_ui_domain
#. Runtime zh-Hans msgstr: "UI的domain必须为action、feedback或dialog。"
msgctxt "OniMcp.MCP.UI_DIALOG.INVALID_UI_DOMAIN"
msgid "UI domain must be action, feedback or dialog."
msgstr "UI的domain必須為action、feedback或dialog。"

#. Runtime JSON key: tools.game_control.parameters.keepPaused
#. Runtime zh-Hans msgstr: "确认MOD不匹配后是否保持暂停，默认为true。false保留原生暂停处理，绝不强制恢复。status和dryRun不改变速度。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.KEEPPAUSED"
msgid "For MOD mismatch acknowledgement, preserve a paused game after native OK; defaults to true. False leaves native pause handling unchanged and never forces resume. Status and dryRun do not change speed."
msgstr "確認MOD不匹配後是否保持暫停，預設為true。false保留原生暫停處理，絕不強制恢復。status和dryRun不改變速度。"

#. Runtime JSON key: ui_dialog.unsupported_action
#. Runtime zh-Hans msgstr: "对话框action必须为status或acknowledge。"
msgctxt "OniMcp.MCP.UI_DIALOG.UNSUPPORTED_ACTION"
msgid "Dialog action must be status or acknowledge."
msgstr "對話框action必須為status或acknowledge。"

#. Runtime JSON key: ui_dialog.unsupported_dialog
#. Runtime zh-Hans msgstr: "仅支持mod_mismatch对话框。"
msgctxt "OniMcp.MCP.UI_DIALOG.UNSUPPORTED_DIALOG"
msgid "Only the mod_mismatch dialog is supported."
msgstr "僅支援mod_mismatch對話框。"

#. Runtime JSON key: ui_dialog.token_required
#. Runtime zh-Hans msgstr: "确认前请读取当前对话框的status，并传入其dialogToken。"
msgctxt "OniMcp.MCP.UI_DIALOG.TOKEN_REQUIRED"
msgid "Read the current dialog status and pass its dialogToken before acknowledging."
msgstr "確認前請讀取目前對話框的status，並傳入其dialogToken。"

#. Runtime JSON key: ui_dialog.token_stale
#. Runtime zh-Hans msgstr: "dialogToken已不匹配当前显示的MOD不匹配对话框。请重新读取status。"
msgctxt "OniMcp.MCP.UI_DIALOG.TOKEN_STALE"
msgid "The dialog token no longer matches the visible MOD mismatch dialog. Read status again."
msgstr "dialogToken已不符合目前顯示的MOD不匹配對話框。請重新讀取status。"

#. Runtime JSON key: ui_dialog.confirm_required
#. Runtime zh-Hans msgstr: "确认MOD不匹配对话框需要confirm=true。"
msgctxt "OniMcp.MCP.UI_DIALOG.CONFIRM_REQUIRED"
msgid "confirm=true is required to acknowledge the MOD mismatch dialog."
msgstr "確認MOD不匹配對話框需要confirm=true。"

#. Runtime JSON key: ui_dialog.unavailable
#. Runtime zh-Hans msgstr: "无法使用原生MOD不匹配对话框UI。"
msgctxt "OniMcp.MCP.UI_DIALOG.UNAVAILABLE"
msgid "The native MOD mismatch dialog UI is unavailable."
msgstr "無法使用原生MOD不匹配對話框UI。"

#. Runtime JSON key: ui_dialog.ambiguous
#. Runtime zh-Hans msgstr: "找到多个当前MOD不匹配对话框，无法确定目标。"
msgctxt "OniMcp.MCP.UI_DIALOG.AMBIGUOUS"
msgid "More than one current MOD mismatch dialog was found; the target is ambiguous."
msgstr "找到多個目前MOD不匹配對話框，無法確定目標。"

#. Runtime JSON key: ui_dialog.blocked
#. Runtime zh-Hans msgstr: "原生UI输入已被禁用，或MOD不匹配对话框前面还有其他对话框。"
msgctxt "OniMcp.MCP.UI_DIALOG.BLOCKED"
msgid "Native UI input is disabled, or another dialog is in front of the MOD mismatch dialog."
msgstr "原生UI輸入已被停用，或MOD不匹配對話框前面還有其他對話框。"

#. Runtime JSON key: ui_dialog.button_unavailable
#. Runtime zh-Hans msgstr: "原生OK按钮尚未准备好接受调用。"
msgctxt "OniMcp.MCP.UI_DIALOG.BUTTON_UNAVAILABLE"
msgid "The native OK button is not ready for invocation."
msgstr "原生OK按鈕尚未準備好接受呼叫。"

#. Runtime JSON key: ui_dialog.unsupported_shape
#. Runtime zh-Hans msgstr: "当前对话框不符合支持的MOD不匹配确认布局。"
msgctxt "OniMcp.MCP.UI_DIALOG.UNSUPPORTED_SHAPE"
msgid "The current dialog does not match the supported MOD mismatch confirmation layout."
msgstr "目前對話框不符合支援的MOD不匹配確認配置。"

#. Runtime JSON key: ui_dialog.click_failed
#. Runtime zh-Hans msgstr: "原生MOD不匹配确认失败：{0}"
msgctxt "OniMcp.MCP.UI_DIALOG.CLICK_FAILED"
msgid "Native MOD mismatch acknowledgement failed: {0}"
msgstr "原生MOD不匹配確認失敗：{0}"

#. Runtime JSON key: ui_dialog.pause_unavailable
#. Runtime zh-Hans msgstr: "原生暂停控制不可用，无法保持暂停状态。"
msgctxt "OniMcp.MCP.UI_DIALOG.PAUSE_UNAVAILABLE"
msgid "Native pause control is unavailable; a paused result cannot be preserved."
msgstr "原生暫停控制不可用，無法保持暫停狀態。"

#. Runtime JSON key: ui_dialog.not_present
#. Runtime zh-Hans msgstr: "当前未显示MOD不匹配对话框。"
msgctxt "OniMcp.MCP.UI_DIALOG.NOT_PRESENT"
msgid "No MOD mismatch dialog is currently visible."
msgstr "目前未顯示MOD不匹配對話框。"

#. Runtime JSON key: tools.game_control.parameters.confirm
#. Runtime zh-Hans msgstr: "写入、危险操作或批量操作所需的确认。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.CONFIRM"
msgid "Required confirmation for write, dangerous, or batch actions."
msgstr "寫入、危險操作或批次操作所需的確認。"

#. Runtime JSON key: ui_dialog.invalid_boolean
#. Runtime zh-Hans msgstr: "参数 `{0}` 必须是 JSON 布尔值。"
msgctxt "OniMcp.MCP.UI_DIALOG.INVALID_BOOLEAN"
msgid "Parameter `{0}` must be a JSON boolean."
msgstr "參數 `{0}` 必須是 JSON 布林值。"


#. Runtime JSON key: speed_trace.description
#. Runtime zh-Hans msgstr: "读取游戏时间或控制暂停、恢复和速度。action=trace 限量读取本体速度调用历史，不改变游戏状态。"
msgctxt "OniMcp.MCP.SPEED_TRACE.DESCRIPTION"
msgid "Read game time or control pause, resume and speed. action=trace reads bounded native speed-call history without changing game state."
msgstr "讀取遊戲時間或控制暫停、恢復和速度。action=trace 限量讀取本體速度呼叫歷史，不改變遊戲狀態。"


#. Runtime JSON key: speed_trace.action.description
#. Runtime zh-Hans msgstr: "操作：time、pause、resume、set_speed或只读trace。trace显示观测到的本体调用；unattributed不代表已确定是用户或其他MOD操作。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ACTION.DESCRIPTION"
msgid "Operation: time, pause, resume, set_speed or read-only trace. Trace shows observed native calls; unattributed does not establish a human or another mod as the actor."
msgstr "操作：time、pause、resume、set_speed或唯讀trace。trace顯示觀測到的本體呼叫；unattributed不代表已確定是使用者或其他MOD操作。"


#. Runtime JSON key: speed_trace.limit.description
#. Runtime zh-Hans msgstr: "trace最大返回条数，1..32，默认8。没有游标时返回最新记录。"
msgctxt "OniMcp.MCP.SPEED_TRACE.LIMIT.DESCRIPTION"
msgid "Maximum trace records, 1..32; default 8. Without a cursor, return the latest records."
msgstr "trace最大回傳筆數，1..32，預設8。沒有游標時回傳最新紀錄。"


#. Runtime JSON key: tools.game_control.parameters.afterSequence
#. Runtime zh-Hans msgstr: "action=trace时，返回此非负整数sequence之后的记录。必须提供先前trace响应中的traceEpoch。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.AFTERSEQUENCE"
msgid "For action=trace, return records after this nonnegative integer sequence. Requires the traceEpoch from a prior trace response."
msgstr "action=trace時，回傳此非負整數sequence之後的紀錄。必須提供先前trace回應中的traceEpoch。"


#. Runtime JSON key: tools.game_control.parameters.traceEpoch
#. Runtime zh-Hans msgstr: "action=trace返回的观测进程不透明标识。与afterSequence一起使用；不同进程的标识会被拒绝。"
msgctxt "OniMcp.MCP.TOOLS.GAME_CONTROL.PARAMETERS.TRACEEPOCH"
msgid "Opaque trace-process epoch returned by action=trace. Required with afterSequence; a different process epoch is rejected."
msgstr "action=trace回傳的觀測程序不透明識別。與afterSequence一起使用；不同程序的識別會被拒絕。"


#. Runtime JSON key: speed_trace.error.invalid_limit
#. Runtime zh-Hans msgstr: "trace的limit必须是1到32的整数。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ERROR.INVALID_LIMIT"
msgid "Trace limit must be an integer from 1 to 32."
msgstr "trace的limit必須是1到32的整數。"


#. Runtime JSON key: speed_trace.error.invalid_after_sequence
#. Runtime zh-Hans msgstr: "trace的afterSequence必须是非负整数。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ERROR.INVALID_AFTER_SEQUENCE"
msgid "Trace afterSequence must be a nonnegative integer."
msgstr "trace的afterSequence必須是非負整數。"


#. Runtime JSON key: speed_trace.error.epoch_required
#. Runtime zh-Hans msgstr: "trace的afterSequence需要先前响应中的traceEpoch。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ERROR.EPOCH_REQUIRED"
msgid "Trace afterSequence requires traceEpoch from a prior response."
msgstr "trace的afterSequence需要先前回應中的traceEpoch。"


#. Runtime JSON key: speed_trace.error.epoch_mismatch
#. Runtime zh-Hans msgstr: "traceEpoch与当前进程不匹配。请先读取当前trace再继续。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ERROR.EPOCH_MISMATCH"
msgid "Trace epoch does not match this process. Read the current trace before continuing."
msgstr "traceEpoch與目前程序不符。請先讀取目前trace再繼續。"


#. Runtime JSON key: speed_trace.error.cursor_future
#. Runtime zh-Hans msgstr: "trace游标超出了已记录的历史。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ERROR.CURSOR_FUTURE"
msgid "Trace cursor is newer than the recorded history."
msgstr "trace游標超出了已記錄的歷史。"

#. Runtime JSON key: speed_trace.error.invalid_action
#. Runtime zh-Hans msgstr: "速度操作必须是time、pause、resume、set_speed或trace。"
msgctxt "OniMcp.MCP.SPEED_TRACE.ERROR.INVALID_ACTION"
msgid "Speed action must be time, pause, resume, set_speed or trace."
msgstr "速度操作必須是time、pause、resume、set_speed或trace。"
